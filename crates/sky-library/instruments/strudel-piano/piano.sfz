<region> sample=Ds6v8.mp3 pitch_keycenter=87 lokey=86 hikey=88
<region> sample=Fs6v8.mp3 pitch_keycenter=90 lokey=89 hikey=91
<region> sample=A6v8.mp3 pitch_keycenter=93 lokey=92 hikey=94
